rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// SR-Cardiocare — Firestore security rules (revision 3)
//
// Authorization reads from the user's own `users/{uid}` document again. The
// previous revision read it from Firebase Auth CUSTOM CLAIMS, which is the
// stronger design — but it depends on the `syncUserClaims` Cloud Function
// being deployed to write those claims, and while that function is missing
// every newly created account has an empty `role` claim and is denied
// everywhere. This revision removes that dependency so account creation works
// without the function.
//
// Note: 'rules_version' 2 is not a typo. Firestore defines versions 1 and 2
// only; there is no version 3. The "revision 3" above refers to this file, not
// to the rules language.
//
// WHAT THIS DOES NOT FIX
// ----------------------
// The Android client refuses a sign-in whose ID token carries no `role` claim
// (see `awaitRoleClaim` in AuthRepository.kt) and calls signOut() before
// Firestore is ever contacted. That gate lives in the shipped APK, so these
// rules cannot influence it. Until either the function is deployed or that
// gate is removed in a new build, a newly created account still cannot log in.
//
// SECURITY NOTE
// -------------
// Roles living in Firestore is only safe because no client can write one:
//   * `users` create requires an admin, or a doctor minting a patient
//     assigned to themselves.
//   * `users` update forbids anyone but an admin from touching `role`, and
//     forbids self-writes of `isBlocked` and `assignedDoctorId`.
// Those two rules are what stop privilege escalation here. Do not relax them.
//
// COST
// ----
// Each helper below resolves through get() on the caller's user document.
// Firestore caches identical document reads within a single rule evaluation,
// so this is roughly one extra read per request — billed, and slower than a
// token lookup. This is the trade being made for not needing the function.
//
// Doctors are scoped to their own patients. Clinical collections carry a
// denormalised `doctorId` so that list queries can be authorised per-document
// without a lookup.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ──────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The caller's own user document. An authenticated caller with no document
    // makes this error, which denies — the same outcome as an explicit deny,
    // so no existence guard is needed (and it would cost a second read).
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return isAuthenticated() ? userDoc().get('role', '') : '';
    }

    // Blocking an account revokes API access, not merely the UI. Unlike the
    // claims version, a block now takes effect on the next request rather than
    // waiting for a token refresh.
    function isActive() {
      return isAuthenticated() && userDoc().get('isBlocked', false) != true;
    }

    function isAdmin()   { return isActive() && role() == 'admin';  }
    function isDoctor()  { return isActive() && role() == 'doctor'; }
    function isPatient() { return isActive() && role() == 'patient';}
    function isClinician() { return isDoctor() || isAdmin(); }

    // The doctor this patient is assigned to, off their own user document.
    function myDoctorId() {
      return isAuthenticated() ? userDoc().get('assignedDoctorId', '') : '';
    }

    // ── Scoping ───────────────────────────────────────────────────────────

    // A clinician may reach a record when they are an admin, or when the
    // record names them as the responsible doctor. Clinical collections carry
    // a denormalised doctorId precisely so this works on list queries.
    function ownsRecord() {
      return isAdmin() || (isDoctor() && resource.data.get('doctorId', '') == uid());
    }

    // Path-addressed collections (chat) cannot denormalise, so fall back to a
    // single lookup of the patient's user document.
    function isMyPatient(patientId) {
      return isAdmin() || (isDoctor() &&
        exists(/databases/$(database)/documents/users/$(patientId)) &&
        get(/databases/$(database)/documents/users/$(patientId))
          .data.get('assignedDoctorId', '') == uid());
    }

    function unchanged(key) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own doc is readable even while blocked, so the app can render the
      // "account blocked" screen instead of hanging on a denied read. This
      // also has to stay open to any authenticated caller reading themselves,
      // because every helper above depends on being able to read this doc.
      // Doctors see their own patients, plus other doctors (needed by the
      // reassignment picker) — but never another doctor's patients.
      allow get: if isAuthenticated() && (
        uid() == userId ||
        isAdmin() ||
        myDoctorId() == userId ||
        (isDoctor() && (
          resource.data.get('assignedDoctorId', '') == uid() ||
          resource.data.get('role', '') == 'doctor'
        ))
      );

      // List queries are authorised per returned document, so a doctor's
      // query must already be constrained to their own patients (or to
      // role == 'doctor') or it will be rejected wholesale.
      allow list: if isAdmin() || (isDoctor() && (
        resource.data.get('assignedDoctorId', '') == uid() ||
        resource.data.get('role', '') == 'doctor'
      ));

      // This is the rule that keeps roles in Firestore safe. Own profile
      // updates cannot touch authorization fields; doctors may administer
      // their own patients but never write a role.
      allow update: if isAdmin() || (isActive() && (
        (uid() == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role','isBlocked','assignedDoctorId'])) ||
        (isDoctor() && uid() != userId &&
          resource.data.get('assignedDoctorId', '') == uid() &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role']))
      ));

      // Doctors may only ever mint patients assigned to themselves; only an
      // admin can create a doctor or another admin.
      allow create: if request.resource.data.role in ['patient','doctor','admin']
        && request.resource.data.get('isBlocked', false) == false
        && (
          isAdmin() ||
          (isDoctor() &&
            request.resource.data.role == 'patient' &&
            request.resource.data.get('assignedDoctorId', '') == uid())
        );

      allow delete: if isAdmin();
    }

    // ── Account deletion requests ─────────────────────────────────────────
    // Written only by the `requestAccountDeletion` callable, which runs on the
    // Admin SDK and bypasses these rules. No client write path exists on
    // purpose: the request also blocks the account, and a client that could
    // author these documents could block anyone it could name. Clinicians read
    // them because they are the ones who have to action the deletion.
    match /accountDeletionRequests/{userId} {
      allow get, list:              if isAdmin() ||
        (isDoctor() && resource.data.get('assignedDoctorId', '') == uid());
      allow create, update, delete: if false;
    }

    // ── Exercise library (shared clinical content, not patient data) ───────
    match /exercises/{exerciseId} {
      allow read:                    if isActive();
      allow create, update, delete:  if isClinician();
    }

    match /videos/{videoId} {
      allow read:                   if isActive();
      allow create, update, delete: if isClinician();
    }

    // ── Plans ─────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isAdmin() ||
        (isDoctor() && request.resource.data.get('doctorId', '') == uid());
      allow update, delete: if ownsRecord();
    }

    // ── Assignments ───────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isAdmin() ||
        (isDoctor() && request.resource.data.get('doctorId', '') == uid());
      allow update, delete: if ownsRecord();
    }

    // ── Session Logs ──────────────────────────────────────────────────────
    // Written by patients; `doctorId` is denormalised from the patient's own
    // assignedDoctorId so it cannot be spoofed to reach another clinician's
    // caseload.
    match /sessionLogs/{sessionId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isActive() &&
        request.resource.data.patientId == uid() &&
        request.resource.data.get('doctorId', '') == myDoctorId();
      // patientId and doctorId are immutable — a patient must not be able to
      // re-attribute their own clinical record.
      allow update: if isAdmin() ||
        (isActive() && resource.data.patientId == uid() &&
          unchanged('patientId') && unchanged('doctorId'));
      allow delete: if isAdmin();
    }

    // ── Workouts (legacy, read-only on the client) ─────────────────────────
    match /workouts/{workoutId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isActive() &&
        request.resource.data.patientId == uid() &&
        request.resource.data.get('doctorId', '') == myDoctorId();
      allow update: if ownsRecord() ||
        (isActive() && resource.data.patientId == uid() &&
          unchanged('patientId') && unchanged('doctorId'));
      allow delete: if ownsRecord();
    }

    // ── Post-Workout Feedback ─────────────────────────────────────────────
    match /postWorkoutFeedback/{feedbackId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isActive() &&
        request.resource.data.patientId == uid() &&
        request.resource.data.get('doctorId', '') == myDoctorId();
      allow update, delete: if isAdmin();
    }

    // ── Doctor Feedback (doctor → patient) ────────────────────────────────
    match /feedback/{feedbackId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() || ownsRecord()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.patientId == uid()) ||
        (isDoctor() && resource.data.get('doctorId', '') == uid());
      allow create: if isAdmin() ||
        (isDoctor() && request.resource.data.doctorId == uid());
      allow update, delete: if isAdmin();
    }

    // ── Appointments ──────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow get:  if isActive() && (
        resource.data.patientId == uid() ||
        resource.data.doctorId  == uid() ||
        isAdmin()
      );
      allow list: if isAdmin() ||
        (isActive() && (
          resource.data.patientId == uid() || resource.data.doctorId == uid()
        ));
      // A doctor books under their own name; only an admin may book on behalf
      // of another clinician. A patient may raise a *request* against their own
      // assigned doctor only, and it must start as 'pending' — they cannot
      // self-confirm a slot.
      allow create: if isAdmin() ||
        (isDoctor() && request.resource.data.doctorId == uid()) ||
        (isPatient() &&
          request.resource.data.patientId == uid() &&
          request.resource.data.doctorId == myDoctorId() &&
          request.resource.data.status == 'pending');
      allow update: if isActive() && (
        resource.data.doctorId  == uid() ||
        (resource.data.patientId == uid() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['patientConfirmed','patientNotes'])) ||
        isAdmin()
      );
      allow delete: if isActive() && (
        resource.data.doctorId == uid() || isAdmin()
      );
    }

    // ── Chat ──────────────────────────────────────────────────────────────
    // Thread is addressed by patient UID, so there is no field to denormalise;
    // isMyPatient() costs one document read per access.
    match /chats/{patientId}/messages/{messageId} {
      allow read:   if isActive() && (
        uid() == patientId || isMyPatient(patientId)
      );
      // senderId is pinned to the caller so neither side can forge a message
      // attributed to the other.
      allow create: if isActive()
        && request.resource.data.senderId == uid()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && (uid() == patientId || isMyPatient(patientId));
      allow update, delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────
    // A notification document triggers fanOutNotification, which pushes
    // client-authored title/body/route straight to the recipient's device.
    // Creation is therefore tightly scoped: clinicians may notify anyone,
    // a patient may notify only themselves or their assigned doctor.
    match /notifications/{notificationId} {
      allow get:  if isActive() && (
        resource.data.userId == uid() || isAdmin()
      );
      allow list: if isAdmin() ||
        (isActive() && resource.data.userId == uid());

      allow create: if isActive()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body.size() <= 2000
        && (
          isClinician() ||
          request.resource.data.userId == uid() ||
          request.resource.data.userId == myDoctorId()
        );

      // Recipients may only flip read state — not rewrite the message.
      allow update: if isActive() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isRead','readAt']);
      allow delete: if isAdmin();
    }

    // ── Login Logs ────────────────────────────────────────────────────────
    // Append-only audit trail. Entries are pinned to the caller so login
    // history cannot be fabricated for another account. Deliberately gated on
    // isAuthenticated() alone — not isActive(), and not on any helper that
    // reads the user document — so a blocked user's attempts are still
    // recorded and an account with no user document can still be audited.
    match /loginLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.get('userId', uid()) == uid();
      allow update, delete: if false;
    }

    // ── App Settings ──────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── App Version Gate ──────────────────────────────────────────────────
    // Read is open, deliberately. The update gate runs before the user signs
    // in — that is the whole point, since a build broken badly enough to need
    // forcing out is often one that cannot complete a login. Gating this read
    // on auth would make the kill switch unreachable exactly when it matters.
    //
    // The document carries no personal data: two version numbers and a message
    // that ships to every install anyway. Writes stay admin-only, and the field
    // validation below stops a compromised admin session from bricking every
    // client with a garbage minVersionCode.
    match /config/appVersion {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.minVersionCode is int &&
        request.resource.data.minVersionCode >= 0 &&
        request.resource.data.latestVersionCode is int &&
        request.resource.data.latestVersionCode >=
          request.resource.data.minVersionCode;
    }

    match /config/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── Audit Logs ────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
