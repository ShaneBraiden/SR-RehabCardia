rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// SR-Cardiocare — Cloud Storage security rules
//
// Roles come from Firebase Auth custom claims (see firestore.rules and the
// syncUserClaims Cloud Function). Storage paths are addressed by patient UID
// and carry no metadata to authorise against, so doctor scoping needs one
// cross-service lookup of the patient's user document.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // ── Identity ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function role() {
      return isAuth() ? claims().get('role', '') : '';
    }

    function isActive() {
      return isAuth() && claims().get('isBlocked', false) != true && role() != '';
    }

    function isOwner(uid) {
      return isActive() && request.auth.uid == uid;
    }

    function isAdmin()     { return isActive() && role() == 'admin'; }
    function isDoctor()    { return isActive() && role() == 'doctor'; }
    function isClinician() { return isDoctor() || isAdmin(); }

    // Admins reach any patient; a doctor reaches only their own caseload.
    function isMyPatient(patientId) {
      return isAdmin() || (isDoctor() &&
        firestore.exists(/databases/(default)/documents/users/$(patientId)) &&
        firestore.get(/databases/(default)/documents/users/$(patientId))
          .data.get('assignedDoctorId', '') == request.auth.uid);
    }

    // ── Content type / size guards ────────────────────────────────────────

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|webm|x-msvideo)');
    }

    function isImageOrVideo() {
      return isImage() || isVideo();
    }

    function underMB(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // ── User Profile Images ───────────────────────────────────────────────
    // Path: /users/{userId}/profile/{fileName}
    // Avatars surface across chat and dashboards, so any active user may read
    // them. Only the owner writes.
    match /users/{userId}/profile/{fileName} {
      allow read:   if isActive();
      allow write:  if isOwner(userId) && isImage() && underMB(5);
      allow delete: if isOwner(userId);
    }

    // ── Patient Workout Videos ────────────────────────────────────────────
    // Path: /workouts/{userId}/{fileName}
    // Video of a patient performing exercises is clinical data. Readable by
    // that patient and their own care team only.
    match /workouts/{userId}/{fileName} {
      allow read:   if isOwner(userId) || isMyPatient(userId);
      allow write:  if isOwner(userId) && isVideo() && underMB(500);
      allow delete: if isOwner(userId);
    }

    // ── Session Log Attachments ───────────────────────────────────────────
    // Path: /sessionLogs/{userId}/{sessionId}/{fileName}
    // Heart-rate screenshots, RPE photos, short clips.
    match /sessionLogs/{userId}/{sessionId}/{fileName} {
      allow read:   if isOwner(userId) || isMyPatient(userId);
      allow write:  if isOwner(userId) && isImageOrVideo() && underMB(100);
      allow delete: if isOwner(userId);
    }

    // ── Chat Attachments ──────────────────────────────────────────────────
    // Path: /chats/{patientId}/attachments/{fileName}
    // Scoped to the two parties in the thread.
    match /chats/{patientId}/attachments/{fileName} {
      allow read:   if isOwner(patientId) || isMyPatient(patientId);
      allow write:  if (isOwner(patientId) || isMyPatient(patientId))
                      && isImageOrVideo() && underMB(50);
      allow delete: if isOwner(patientId);
    }

    // ── Exercise Library Videos ───────────────────────────────────────────
    // Shared clinical content, not patient data.
    match /videos/{fileName} {
      allow read:   if isActive();
      allow write:  if isClinician() && isVideo() && underMB(500);
      allow delete: if isClinician();
    }

    // Path: /exercises/{exerciseId}/{fileName}
    // Read-only for clients. Writes must go through a Cloud Function using the
    // Admin SDK — no direct client uploads permitted.
    match /exercises/{exerciseId}/{allPaths=**} {
      allow read:          if isActive();
      allow write, delete: if false;
    }

    // ── Default deny — explicit allowlist above, everything else blocked ───
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
