<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower counterpart of data_extraction_rules.xml. allowBackup
    is already false; this makes the intent explicit for any path that still
    honours fullBackupContent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
