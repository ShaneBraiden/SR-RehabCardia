<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ equivalent of allowBackup="false": nothing leaves the device
    through cloud backup or device-to-device transfer. Health data lives in
    Firestore, and the local session is held in EncryptedSharedPreferences
    whose Keystore key cannot be restored on another device anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
