    <string name="tour_home_notifications_text">உங்கள் மருத்துவரிடமிருந்து வரும் நினைவூட்டல்களும் கருத்துகளும் இங்கே வரும்.</string>
    <string name="tour_home_profile_title">உங்கள் சுயவிவரம்</string>
    <string name="tour_home_profile_text">உங்கள் விவரங்களைப் புதுப்பிக்கவும், கடவுச்சொல்லை மாற்றவும், அல்லது வெளியேறவும்.</string>

    <string name="tour_assignment_card_title">உங்கள் பயிற்சிகள்</string>
    <string name="tour_assignment_card_text">ஒவ்வொரு அட்டையும் உங்கள் மருத்துவர் ஒதுக்கிய பயிற்சி — அதன் சுற்றுகள், முறைகள் மற்றும் எத்தனை முறை செய்ய வேண்டும் என்பதுடன்.</string>
    <string name="tour_assignment_start_title">அமர்வைத் தொடங்கு</string>
    <string name="tour_assignment_start_text">இந்தப் பயிற்சிக்கான வழிகாட்டப்பட்ட அமர்வைத் தொடங்க தட்டவும்.</string>
    <string name="tour_assignment_history_title">வரலாறு</string>
    <string name="tour_assignment_history_text">நீங்கள் இதுவரை முடித்த பயிற்சிகளை மீளாய்வு செய்யுங்கள்.</string>

    <string name="tour_exercise_row_title">உங்கள் பயிற்சிகள்</string>
    <string name="tour_exercise_row_text">ஒவ்வொரு வரிசையும் இன்றைய திட்டத்தில் உள்ள ஒரு பயிற்சி.</string>
    <string name="tour_exercise_start_title">தொடங்கு</string>
    <string name="tour_exercise_start_text">காணொளியைத் திறந்து தொடங்க ஒரு பயிற்சியைத் தட்டவும்.</string>

    <string name="tour_player_video_title">பின்பற்றுங்கள்</string>
    <string name="tour_player_video_text">விளக்கத்தைப் பார்த்து உங்கள் சொந்த வேகத்தில் செய்யுங்கள்.</string>
    <string name="tour_player_fullscreen_title">முழுத்திரை</string>
    <string name="tour_player_fullscreen_text">தெளிவாகப் பார்க்க காணொளியைப் பெரிதாக்க தட்டவும்.</string>
    <string name="tour_player_complete_title">சுற்றை முடிக்கவும்</string>
    <string name="tour_player_complete_text">முடித்ததும், அதைப் பதிவு செய்து அடுத்ததற்குச் செல்ல இங்கே தட்டவும்.</string>

    <string name="tour_aw_video_title">பயிற்சி மாதிரி</string>
    <string name="tour_aw_video_text">தொடங்கும் முன் அசைவு எப்படிச் செய்யப்படுகிறது என்பதைப் பாருங்கள்.</string>
    <string name="tour_aw_target_title">உங்கள் இலக்கு</string>
    <string name="tour_aw_target_text">இந்த அமர்வில் நீங்கள் இலக்காகக் கொள்ள வேண்டிய முறைகளையும் சுற்றுகளையும் இது காட்டுகிறது.</string>
    <string name="tour_aw_primary_title">தொடங்கி தொடரவும்</string>
    <string name="tour_aw_primary_text">பயிற்சியைத் தொடங்கவும் ஒவ்வொரு சுற்றிலும் முன்னேறவும் இந்தப் பொத்தானைப் பயன்படுத்துங்கள்.</string>

    <string name="tour_feedback_pain_title">ஏதேனும் வலி?</string>
    <string name="tour_feedback_pain_text">அமர்வின் போது வலி ஏற்பட்டதா, எங்கே ஏற்பட்டது என்பதைத் தெரிவியுங்கள்.</string>
    <string name="tour_feedback_borg_title">எப்படி உணர்ந்தீர்கள்</string>
    <string name="tour_feedback_borg_text">முயற்சியும் மூச்சும் எவ்வளவு கடினமாக இருந்தது என்பதை இந்த சறுக்கிகளால் மதிப்பிடுங்கள்.</string>
    <string name="tour_feedback_pulse_title">உங்கள் நாடித்துடிப்பு</string>
    <string name="tour_feedback_pulse_text">உங்கள் மருத்துவர் கண்காணிக்க உங்கள் இதயத் துடிப்பை உள்ளிடவும்.</string>
    <string name="tour_feedback_submit_title">அனுப்புங்கள்</string>
    <string name="tour_feedback_submit_text">உங்கள் சிகிச்சைக் குழுவுடன் பகிர உங்கள் கருத்தைச் சமர்ப்பியுங்கள்.</string>

    <string name="tour_schedule_calendar_title">உங்கள் நாட்காட்டி</string>
    <string name="tour_schedule_calendar_text">சந்திப்புகளையும் நினைவூட்டல்களையும் காண ஒரு நாளைத் தட்டவும்.</string>
    <string name="tour_schedule_add_title">நினைவூட்டலைச் சேர்</string>
    <string name="tour_schedule_add_text">உங்கள் அமர்வுகளில் தொடர்ந்து இருக்க நினைவூட்டல்களை உருவாக்குங்கள்.</string>

    <string name="tour_analytics_range_title">கால அளவு</string>
    <string name="tour_analytics_range_text">வாரம், மாதம் மற்றும் நீண்ட காலக் காட்சிகளுக்கு இடையே மாறவும்.</string>
    <string name="tour_analytics_chart_title">உங்கள் போக்கு</string>
    <string name="tour_analytics_chart_text">உங்கள் செயல்பாடு காலப்போக்கில் எப்படி மாறுகிறது என்பதை இந்த விளக்கபடம் காட்டுகிறது.</string>
    <string name="tour_analytics_metrics_title">முக்கிய எண்கள்</string>
    <string name="tour_analytics_metrics_text">விரைவான புள்ளிவிவரங்கள் உங்கள் குணமடைதலைச் சுருக்கமாகக் காட்டுகின்றன.</string>

    <string name="tour_chat_field_title">செய்தி எழுதுங்கள்</string>
    <string name="tour_chat_field_text">உங்கள் சிகிச்சைக் குழுவுக்கு இங்கே செய்தியை உள்ளிடுங்கள்.</string>
    <string name="tour_chat_send_title">அனுப்பு</string>
    <string name="tour_chat_send_text">உங்கள் செய்தியை அனுப்ப தட்டவும்.</string>

    <string name="tour_profile_edit_title">சுயவிவரத்தைத் திருத்து</string>
    <string name="tour_profile_edit_text">உங்கள் தனிப்பட்ட மற்றும் உடல்நல விவரங்களைப் புதுப்பித்து வைத்திருங்கள்.</string>
    <string name="tour_profile_password_title">கடவுச்சொல்லை மாற்று</string>
    <string name="tour_profile_password_text">உங்கள் கணக்கைப் பாதுகாப்பாக வைக்க கடவுச்சொல்லைப் புதுப்பியுங்கள்.</string>
    <string name="tour_profile_logout_title">வெளியேறு</string>
    <string name="tour_profile_logout_text">வெளியேறத் தயாராகும் போது இங்கே தட்டவும்.</string>

    <string name="tour_history_list_title">உங்கள் வரலாறு</string>
    <string name="tour_history_list_text">கடந்த பயிற்சிகளையும் அவை எவ்வளவு நன்றாக முடிக்கப்பட்டன என்பதையும் மீளாய்வு செய்யுங்கள்.</string>

    <string name="tour_notification_item_title">அறிவிப்புகள்</string>
    <string name="tour_notification_item_text">எதைப் பற்றியது என்பதைத் திறக்க ஒரு உருப்படியைத் தட்டவும்.</string>
    <string name="tour_notification_read_title">படித்ததாகக் குறி</string>
    <string name="tour_notification_read_text">பார்த்த பிறகு அறிவிப்புகளை அழிக்கவும்.</string>
</resources>
